# ── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ORGANIZATION_ID=
# Legacy alias (optional): NEXT_PUBLIC_DEMO_ORGANIZATION_ID=

# ── Supabase (production cloud instance) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── OpenAI ──────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Razorpay Billing ────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_WEBHOOK_SECRET=whsec_...
# Create subscription Plans in Razorpay Dashboard → Subscriptions:
RAZORPAY_PLAN_STARTER_MONTHLY=plan_...
RAZORPAY_PLAN_STARTER_YEARLY=plan_...
RAZORPAY_PLAN_TEAM_PRO_MONTHLY=plan_...
RAZORPAY_PLAN_TEAM_PRO_YEARLY=plan_...
RAZORPAY_PLAN_ENTERPRISE_MONTHLY=plan_...
RAZORPAY_PLAN_ENTERPRISE_YEARLY=plan_...

# ── OpenRouter ──────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ── Integrations (OAuth) ───────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_BOT_TOKEN=        # Optional: fallback for Slack sync
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NEXUS_VAULT_MASTER_KEY= # 32-byte hex key for credential encryption

